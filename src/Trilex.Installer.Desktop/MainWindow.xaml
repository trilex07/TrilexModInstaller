<Window x:Class="Trilex.Installer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Trilex Mod Installer" Width="1440" Height="960" MinWidth="1024" MinHeight="740" Icon="Assets/Trilex_mod_installer.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Background="#070E16" TextElement.Foreground="#EAF6FF" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0B1520" BorderBrush="#213747" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,24">
    <StackPanel DockPanel.Dock="Top"><Image Source="Assets/Trilex_logo_256.png" Height="110" Stretch="Uniform"/><TextBlock Text="T R I L E X" FontSize="21" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="MOD INSTALLER" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,32"/><Border Background="#0B3950" BorderBrush="#17BFFF" BorderThickness="2,0,0,0" Padding="12,14"><TextBlock Text="{Binding L[Library]}" Foreground="#53DCFF"/></Border></StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock Text="0.1.0 • RC" Foreground="{StaticResource Muted}"/><TextBlock Text="TRILEX07" FontSize="10" Foreground="#17BFFF" Margin="0,6,0,8"/><TextBlock Text="{Binding L[Safety]}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,20,28,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Trilex Mod Installer" FontSize="33" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Tagline]}" Foreground="#17BFFF" FontSize="11" Margin="1,8,0,0"/></StackPanel><ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding UiLanguage}" AutomationProperties.Name="Installer language"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel>
     <TextBlock Text="{Binding L[LibraryHint]}" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" BorderBrush="#17BFFF" Background="#102737" Margin="0,0,12,0" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="Assets/01_game_library.png" Width="62" Height="64"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Singularity VR" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Available]}" FontSize="9" Foreground="#53DCFF" Margin="0,7,0,0"/></StackPanel></Grid></Border>
      <Border Grid.Column="1" Style="{StaticResource Panel}" Opacity="0.5" Margin="0,0,12,0" Padding="20"><StackPanel><TextBlock Text="The Darkness II VR" FontSize="21"/><TextBlock Text="{Binding L[Soon]}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" Opacity="0.5" Padding="20"><StackPanel><TextBlock Text="{Binding L[More]}" FontSize="18"/><TextBlock Text="{Binding L[Soon]}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     </Grid>
     <Grid IsEnabled="{Binding NotBusy}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding L[Folder]}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{Binding L[DetectionHint]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/><TextBox Text="{Binding GameRoot,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Game installation folder" MinWidth="180"/><WrapPanel Margin="0,14,0,0"><Button Content="{Binding L[Detect]}" Click="Detect_Click"/><Button Content="{Binding L[Browse]}" Click="Browse_Click"/><Button Content="{Binding L[Validate]}" Click="Validate_Click"/></WrapPanel><TextBlock Text="{Binding DetectionStatus}" Foreground="#53DCFF" Margin="0,8,0,0"/><Border Height="1" Background="#263C50" Margin="0,22,0,22"/><TextBlock Text="{Binding L[Options]}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Independent]}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding L[Text]}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TextLanguage}" AutomationProperties.Name="Game text language"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding L[Voice]}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding VoiceLanguage}" AutomationProperties.Name="Game dubbing language"/></StackPanel></Grid>
       <CheckBox IsChecked="{Binding Offline}" Content="{Binding L[Offline]}" Margin="0,20,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="{Binding L[Import]}" Click="Import_Click"/><Button Content="{Binding L[Cache]}" Click="Cache_Click"/></WrapPanel>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="{Binding L[Modules]}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding L[ModuleHint]}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
       <ItemsControl ItemsSource="{Binding Modules}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#263C50" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Selectable}" AutomationProperties.Name="{Binding Name}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,8,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="#F9A928" FontSize="10" VerticalAlignment="Top"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Panel}" Margin="0,20,0,0" Visibility="{Binding ReviewVisibility}"><StackPanel><TextBlock Text="{Binding L[Review]}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewText}" Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><TextBlock Text="{Binding L[Backup]}" Foreground="#9FB5C9" FontSize="12"/><WrapPanel Margin="0,16,0,0"><Button Content="{Binding L[Download]}" Style="{StaticResource Primary}" Click="Install_Click" IsEnabled="{Binding CanInstall}"/><Button Content="{Binding L[Back]}" Click="Back_Click"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,20,0,4"><StackPanel><TextBlock Text="{Binding L[Status]}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Activity}" Margin="0,10,0,8"/><ProgressBar Value="{Binding Percent,Mode=OneWay}" Maximum="100" Height="5" Foreground="#17BFFF" Background="#20384A"/><TextBlock Text="{Binding TrustStatus}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><Button Content="{Binding L[Review]}" Style="{StaticResource Primary}" Click="Review_Click" IsEnabled="{Binding NotBusy}"/><Button Content="{Binding L[Verify]}" Click="Verify_Click" IsEnabled="{Binding CanManage}"/><Button Content="{Binding L[Repair]}" Click="Repair_Click" IsEnabled="{Binding CanManage}"/><Button Content="{Binding L[Update]}" Click="Update_Click" IsEnabled="{Binding NotBusy}"/><Button Content="{Binding L[Uninstall]}" Click="Uninstall_Click" IsEnabled="{Binding CanManage}"/><Button Content="{Binding L[Recover]}" Click="Recover_Click" IsEnabled="{Binding NotBusy}"/><Button Content="{Binding L[OpenLogs]}" Click="Logs_Click"/></WrapPanel><StackPanel Grid.Column="1"><Button Content="{Binding L[Cancel]}" Click="Cancel_Click" IsEnabled="{Binding Busy}"/><Button Content="{Binding L[Launch]}" Click="Launch_Click" IsEnabled="{Binding CanLaunch}"/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
