<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/Trilex_mod_installer.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TrilexModInstaller</AssemblyName><PublishTrimmed>false</PublishTrimmed>
    <BootstrapCatalog Condition="'$(BootstrapCatalog)'==''">../../catalog/bootstrap.json</BootstrapCatalog>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Trilex.Installer.Core/Trilex.Installer.Core.csproj"/><Resource Include="Assets/*"/>
    <EmbeddedResource Include="$(BootstrapCatalog)" LogicalName="Trilex.Installer.Desktop.bootstrap.json"/>
    <EmbeddedResource Include="../../catalog/trusted-publisher.pem" Link="trusted-publisher.pem"/>
  </ItemGroup>
</Project>
